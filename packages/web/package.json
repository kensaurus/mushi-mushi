{
  "name": "@mushi-mushi/web",
  "version": "1.28.0",
  "description": "Bug report and user feedback widget for the web. The bug mediator for AI-built apps: plain-English diagnosis + a ready fix, in your editor.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/mushi.loader.global.js",
  "jsdelivr": "./dist/mushi.loader.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./test-utils": {
      "import": {
        "types": "./dist/test-utils.d.ts",
        "default": "./dist/test-utils.js"
      },
      "require": {
        "types": "./dist/test-utils.d.cts",
        "default": "./dist/test-utils.cjs"
      }
    },
    "./i18n": {
      "import": {
        "types": "./dist/i18n/index.d.ts",
        "default": "./dist/i18n/index.js"
      },
      "require": {
        "types": "./dist/i18n/index.d.cts",
        "default": "./dist/i18n/index.cjs"
      }
    },
    "./otel": {
      "import": {
        "types": "./dist/otel.d.ts",
        "default": "./dist/otel.js"
      },
      "require": {
        "types": "./dist/otel.d.cts",
        "default": "./dist/otel.cjs"
      }
    },
    "./headless": {
      "import": {
        "types": "./dist/headless.d.ts",
        "default": "./dist/headless.js"
      },
      "require": {
        "types": "./dist/headless.d.cts",
        "default": "./dist/headless.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "test-utils": [
        "./dist/test-utils.d.ts"
      ],
      "i18n": [
        "./dist/i18n/index.d.ts"
      ],
      "otel": [
        "./dist/otel.d.ts"
      ],
      "headless": [
        "./dist/headless.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kensaurus/mushi-mushi.git",
    "directory": "packages/web"
  },
  "homepage": "https://kensaur.us/mushi-mushi",
  "bugs": {
    "url": "https://github.com/kensaurus/mushi-mushi/issues"
  },
  "keywords": [
    "mushi-mushi",
    "bug-report-widget",
    "bug-translation",
    "vibe-coding",
    "ai-debugging",
    "ai-triage",
    "auto-fix",
    "mcp",
    "cursor",
    "claude-code",
    "browser-sdk",
    "widget",
    "shadow-dom",
    "screenshot",
    "session-replay",
    "shake-to-report",
    "vanilla-js",
    "vue",
    "svelte",
    "angular",
    "sentry-companion",
    "ai-agent",
    "sdk"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "Core SDK bundle (minified + gzipped)",
      "path": "dist/index.js",
      "limit": "89.5 KB",
      "gzip": true
    },
    {
      "name": "Core SDK bundle (uncompressed)",
      "path": "dist/index.js",
      "limit": "105 KB"
    },
    {
      "name": "Headless capture bundle (no widget, gzipped)",
      "path": "dist/headless.js",
      "limit": "35 KB",
      "gzip": true
    },
    {
      "name": "OTel bridge bundle (gzipped)",
      "path": "dist/otel.js",
      "limit": "5 KB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@mushi-mushi/core": "workspace:^"
  },
  "optionalDependencies": {
    "rrweb": "^2.0.1"
  },
  "devDependencies": {
    "@mushi-mushi/eslint-config": "workspace:*",
    "@mushi-mushi/tsconfig": "workspace:*",
    "eslint-plugin-mushi-mushi": "workspace:*",
    "@size-limit/file": "^12.1.0",
    "eslint": "^10.6.0",
    "jsdom": "^29.1.1",
    "size-limit": "^12.1.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "author": "Kenji Sakuramoto <kensaurus@gmail.com> (https://github.com/kensaurus)",
  "engines": {
    "node": ">=20.19.0"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/kensaurus"
  }
}
