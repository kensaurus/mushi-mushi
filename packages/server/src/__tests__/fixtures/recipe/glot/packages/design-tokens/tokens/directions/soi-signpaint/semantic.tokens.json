{
  "$schema": "https://design-tokens.github.io/community-group/format/2025.10/schema.json",
  "$description": "Soi Signpaint semantic roles. us.kensaur.mushi.cssVar is the glot CSS variable each role sets. us.kensaur.glot.dark is the night-street primitive for dark mode, alsoSets lists legacy variables the scoped layer also points at the role, and contrast / contrastDark record WCAG 2.x ratios, recomputed and asserted by `npm run tokens:direction -- --check` and __tests__/direction-tokens.test.ts.",
  "color": {
    "$type": "color",
    "surface": {
      "base": {
        "$value": "{color.palette.wall}",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "cssVar": "--color-bg",
            "ts": "soiSignpaint.color.surface.base"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.wall}",
            "alsoSets": [
              "--register-canvas",
              "--active-domain-bg",
              "--color-surface-app"
            ]
          }
        }
      },
      "raised": {
        "$value": "{color.palette.plate}",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "cssVar": "--color-surface",
            "ts": "soiSignpaint.color.surface.raised"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.plate}",
            "alsoSets": [
              "--color-surface-elevated"
            ]
          }
        }
      },
      "raisedHover": {
        "$value": "{color.palette.plate-hover}",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "cssVar": "--color-surface-hover"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.plate-hover}",
            "alsoSets": [
              "--color-surface-active"
            ]
          }
        }
      },
      "sunken": {
        "$value": "{color.palette.sunken}",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "cssVar": "--color-surface-sunken"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.sunken}"
          }
        }
      }
    },
    "text": {
      "primary": {
        "$value": "{color.palette.ink}",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "cssVar": "--color-text-primary",
            "ts": "soiSignpaint.color.text.primary"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.cream}",
            "contrast": [
              {
                "against": "{color.surface.base}",
                "min": 4.5,
                "ratio": 15.5,
                "use": "body text on the wall"
              },
              {
                "against": "{color.surface.raised}",
                "min": 4.5,
                "ratio": 17.91,
                "use": "body text on a plate"
              },
              {
                "against": "{color.surface.raisedHover}",
                "min": 4.5,
                "ratio": 14.8,
                "use": "body text on a hovered plate"
              }
            ],
            "contrastDark": [
              {
                "against": "{color.surface.base}",
                "min": 4.5,
                "ratio": 15.76,
                "use": "body text on the wall"
              },
              {
                "against": "{color.surface.raised}",
                "min": 4.5,
                "ratio": 14.11,
                "use": "body text on a plate"
              },
              {
                "against": "{color.surface.raisedHover}",
                "min": 4.5,
                "ratio": 12.65,
                "use": "body text on a hovered plate"
              }
            ]
          }
        }
      },
      "secondary": {
        "$value": "{color.palette.ink-2}",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "cssVar": "--color-text-secondary",
            "ts": "soiSignpaint.color.text.secondary"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.cream-2}",
            "alsoSets": [
              "--color-muted"
            ],
            "contrast": [
              {
                "against": "{color.surface.base}",
                "min": 4.5,
                "ratio": 6.5,
                "use": "secondary text on the wall"
              },
              {
                "against": "{color.surface.raised}",
                "min": 4.5,
                "ratio": 7.52,
                "use": "secondary text on a plate"
              },
              {
                "against": "{color.surface.raisedHover}",
                "min": 4.5,
                "ratio": 6.21,
                "use": "secondary text on a hovered plate"
              }
            ],
            "contrastDark": [
              {
                "against": "{color.surface.base}",
                "min": 4.5,
                "ratio": 10.4,
                "use": "secondary text on the wall"
              },
              {
                "against": "{color.surface.raised}",
                "min": 4.5,
                "ratio": 9.32,
                "use": "secondary text on a plate"
              },
              {
                "against": "{color.surface.raisedHover}",
                "min": 4.5,
                "ratio": 8.35,
                "use": "secondary text on a hovered plate"
              }
            ]
          }
        }
      },
      "tertiary": {
        "$value": "{color.palette.ink-3}",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "cssVar": "--color-text-tertiary"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.cream-3}",
            "contrast": [
              {
                "against": "{color.surface.base}",
                "min": 4.5,
                "ratio": 5.07,
                "use": "tertiary text on the wall"
              },
              {
                "against": "{color.surface.raised}",
                "min": 4.5,
                "ratio": 5.86,
                "use": "tertiary text on a plate"
              },
              {
                "against": "{color.surface.raisedHover}",
                "min": 4.5,
                "ratio": 4.84,
                "use": "tertiary text on a hovered plate"
              }
            ],
            "contrastDark": [
              {
                "against": "{color.surface.base}",
                "min": 4.5,
                "ratio": 6.91,
                "use": "tertiary text on the wall"
              },
              {
                "against": "{color.surface.raised}",
                "min": 4.5,
                "ratio": 6.19,
                "use": "tertiary text on a plate"
              },
              {
                "against": "{color.surface.raisedHover}",
                "min": 4.5,
                "ratio": 5.55,
                "use": "tertiary text on a hovered plate"
              }
            ]
          }
        }
      },
      "onAction": {
        "$value": "{color.palette.on-signal}",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "cssVar": "--color-on-cta",
            "ts": "soiSignpaint.color.text.onAction"
          },
          "us.kensaur.glot": {
            "dark": "{color.palette.on-signal}",
            "contrast": [
              {
                "against": "{color.action.primary}",
                "min": 4.5,
                "ratio": 5.49,
                "use": "label on the enamel-red action"
              },
              {
                "against": "{color.action.primaryHover}",
                "min": 4.5,
                "ratio": 6.96,
                "use": "label on hover"
              }
            ],
            "contrastDark": [
              {
                "against": "{color.action.primary}",
                "min": 4.5,
                "ratio": 4.77,
                "use": "label on the enamel-red action"
              },
              {
                "against": "{color.action.primaryHover}",
                "min": 4.5,
                "ratio": 5.62,
                "use": "label on hover"
              }
            ]
          }
        }
      },
      "onSecondary": {
        "$value": "{color.palette.plate}",
        "$description": "Text on a plate-blue fill (selection, positive marks).",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "cssVar": "--color-text-inverse"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.wall}",
            "contrast": [
              {
                "against": "{color.action.secondary}",
                "min": 4.5,
                "ratio": 8.06,
                "use": "text on plate blue"
              }
            ],
            "contrastDark": [
              {
                "against": "{color.action.secondary}",
                "min": 4.5,
                "ratio": 7.72,
                "use": "text on plate blue"
              }
            ]
          }
        }
      },
      "onReward": {
        "$value": "{color.palette.ink}",
        "$description": "Ink on a turmeric reward plate.",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "cssVar": "--soi-on-reward"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.wall}",
            "contrast": [
              {
                "against": "{color.feedback.reward}",
                "min": 4.5,
                "ratio": 9.48,
                "use": "ink on turmeric"
              }
            ],
            "contrastDark": [
              {
                "against": "{color.feedback.reward}",
                "min": 4.5,
                "ratio": 11.21,
                "use": "ink on turmeric"
              }
            ]
          }
        }
      },
      "signal": {
        "$value": "{color.palette.signal}",
        "$description": "Enamel red as text or icon (correctness).",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "cssVar": "--color-cta-foreground"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.neon-red}",
            "alsoSets": [
              "--color-error",
              "--color-error-foreground"
            ],
            "contrast": [
              {
                "against": "{color.surface.base}",
                "min": 4.5,
                "ratio": 4.75,
                "use": "red text on the wall"
              },
              {
                "against": "{color.surface.raised}",
                "min": 4.5,
                "ratio": 5.49,
                "use": "red text on a plate"
              },
              {
                "against": "{color.surface.raisedHover}",
                "min": 4.5,
                "ratio": 4.54,
                "use": "red text on a hovered plate"
              }
            ],
            "contrastDark": [
              {
                "against": "{color.surface.base}",
                "min": 4.5,
                "ratio": 6.69,
                "use": "red text on the wall"
              },
              {
                "against": "{color.surface.raised}",
                "min": 4.5,
                "ratio": 5.99,
                "use": "red text on a plate"
              },
              {
                "against": "{color.surface.raisedHover}",
                "min": 4.5,
                "ratio": 5.37,
                "use": "red text on a hovered plate"
              }
            ]
          }
        }
      },
      "reward": {
        "$value": "{color.palette.mustard-text}",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "cssVar": "--color-accent-text"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.neon-mustard}",
            "alsoSets": [
              "--color-warning-foreground"
            ],
            "contrast": [
              {
                "against": "{color.surface.base}",
                "min": 4.5,
                "ratio": 5.63,
                "use": "turmeric text on the wall"
              },
              {
                "against": "{color.surface.raised}",
                "min": 4.5,
                "ratio": 6.5,
                "use": "turmeric text on a plate"
              },
              {
                "against": "{color.surface.raisedHover}",
                "min": 4.5,
                "ratio": 5.38,
                "use": "turmeric text on a hovered plate"
              }
            ],
            "contrastDark": [
              {
                "against": "{color.surface.base}",
                "min": 4.5,
                "ratio": 11.21,
                "use": "turmeric text on the wall"
              },
              {
                "against": "{color.surface.raised}",
                "min": 4.5,
                "ratio": 10.04,
                "use": "turmeric text on a plate"
              },
              {
                "against": "{color.surface.raisedHover}",
                "min": 4.5,
                "ratio": 9,
                "use": "turmeric text on a hovered plate"
              }
            ]
          }
        }
      },
      "link": {
        "$value": "{color.palette.blue}",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "cssVar": "--soi-link",
            "ts": "soiSignpaint.color.text.link"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.neon-blue}",
            "contrast": [
              {
                "against": "{color.surface.base}",
                "min": 4.5,
                "ratio": 6.97,
                "use": "plate-blue text on the wall"
              },
              {
                "against": "{color.surface.raised}",
                "min": 4.5,
                "ratio": 8.06,
                "use": "plate-blue text on a plate"
              },
              {
                "against": "{color.surface.raisedHover}",
                "min": 4.5,
                "ratio": 6.66,
                "use": "plate-blue text on a hovered plate"
              }
            ],
            "contrastDark": [
              {
                "against": "{color.surface.base}",
                "min": 4.5,
                "ratio": 7.72,
                "use": "plate-blue text on the wall"
              },
              {
                "against": "{color.surface.raised}",
                "min": 4.5,
                "ratio": 6.91,
                "use": "plate-blue text on a plate"
              },
              {
                "against": "{color.surface.raisedHover}",
                "min": 4.5,
                "ratio": 6.2,
                "use": "plate-blue text on a hovered plate"
              }
            ]
          }
        }
      }
    },
    "action": {
      "primary": {
        "$value": "{color.palette.signal}",
        "$description": "The one filled action per view.",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "cssVar": "--color-cta",
            "ts": "soiSignpaint.color.action.primary"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.signal}",
            "contrast": [
              {
                "against": "{color.surface.base}",
                "min": 3,
                "ratio": 4.75,
                "use": "action fill vs the wall (UI)"
              },
              {
                "against": "{color.surface.raised}",
                "min": 3,
                "ratio": 5.49,
                "use": "action fill vs a plate (UI)"
              }
            ],
            "contrastDark": [
              {
                "against": "{color.surface.base}",
                "min": 3,
                "ratio": 3.82,
                "use": "action fill vs the wall (UI)"
              },
              {
                "against": "{color.surface.raised}",
                "min": 3,
                "ratio": 3.42,
                "use": "action fill vs a plate (UI)"
              }
            ]
          }
        }
      },
      "primaryHover": {
        "$value": "{color.palette.signal-hover}",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "cssVar": "--color-cta-hover"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.signal-hover}",
            "contrast": [
              {
                "against": "{color.surface.base}",
                "min": 3,
                "ratio": 6.02,
                "use": "hover fill vs the wall (UI)"
              }
            ],
            "contrastDark": [
              {
                "against": "{color.surface.base}",
                "min": 3,
                "ratio": 3.24,
                "use": "hover fill vs the wall (UI)"
              }
            ]
          }
        }
      },
      "secondary": {
        "$value": "{color.palette.blue}",
        "$description": "Street-plate blue: selection and positive state. Never a second filled CTA.",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "cssVar": "--color-success",
            "ts": "soiSignpaint.color.action.secondary"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.neon-blue}",
            "alsoSets": [
              "--color-success-foreground",
              "--color-info",
              "--color-info-foreground"
            ],
            "contrast": [
              {
                "against": "{color.surface.base}",
                "min": 3,
                "ratio": 6.97,
                "use": "plate blue vs the wall (UI)"
              }
            ],
            "contrastDark": [
              {
                "against": "{color.surface.base}",
                "min": 3,
                "ratio": 7.72,
                "use": "plate blue vs the wall (UI)"
              }
            ]
          }
        }
      }
    },
    "feedback": {
      "reward": {
        "$value": "{color.palette.mustard}",
        "$description": "Earned reward moments only: a turmeric plate under ink text, or a neon at night.",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "cssVar": "--color-accent",
            "ts": "soiSignpaint.color.feedback.reward"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.neon-mustard}",
            "alsoSets": [
              "--color-accent-hover",
              "--color-warning"
            ]
          }
        }
      }
    },
    "line": {
      "default": {
        "$value": "{color.palette.ink}",
        "$description": "Painted 3px sign outline.",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "cssVar": "--color-border",
            "ts": "soiSignpaint.color.line.default"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.line}",
            "contrast": [
              {
                "against": "{color.surface.base}",
                "min": 3,
                "ratio": 15.5,
                "use": "outline vs the wall (UI)"
              },
              {
                "against": "{color.surface.raised}",
                "min": 3,
                "ratio": 17.91,
                "use": "outline vs a plate (UI)"
              }
            ],
            "contrastDark": [
              {
                "against": "{color.surface.base}",
                "min": 3,
                "ratio": 4.68,
                "use": "outline vs the wall (UI)"
              },
              {
                "against": "{color.surface.raised}",
                "min": 3,
                "ratio": 4.19,
                "use": "outline vs a plate (UI)"
              }
            ]
          }
        }
      },
      "strong": {
        "$value": "{color.palette.ink}",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "cssVar": "--color-border-strong"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.cream-2}",
            "contrast": [
              {
                "against": "{color.surface.base}",
                "min": 3,
                "ratio": 15.5,
                "use": "strong line vs the wall (UI)"
              }
            ],
            "contrastDark": [
              {
                "against": "{color.surface.base}",
                "min": 3,
                "ratio": 10.4,
                "use": "strong line vs the wall (UI)"
              }
            ]
          }
        }
      },
      "focus": {
        "$value": "{color.palette.blue}",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "cssVar": "--color-focus-ring",
            "ts": "soiSignpaint.color.line.focus"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.neon-blue}",
            "contrast": [
              {
                "against": "{color.surface.base}",
                "min": 3,
                "ratio": 6.97,
                "use": "focus ring vs the wall (UI)"
              }
            ],
            "contrastDark": [
              {
                "against": "{color.surface.base}",
                "min": 3,
                "ratio": 7.72,
                "use": "focus ring vs the wall (UI)"
              }
            ]
          }
        }
      },
      "shade": {
        "$value": "{color.palette.ink}",
        "$description": "Hard offset shade, never blurred.",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "cssVar": "--soi-shade-color",
            "ts": "soiSignpaint.color.line.shade"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.shade}",
            "alsoSets": [
              "--color-cta-shadow"
            ]
          }
        }
      }
    },
    "street": {
      "$description": "Street canvas colours. Decorative: the HUD states the same counts in text.",
      "wall": {
        "$value": "{color.palette.wall}",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "ts": "soiSignpaint.color.street.wall"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.wall}"
          }
        }
      },
      "facade": {
        "$value": "{color.palette.facade}",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "ts": "soiSignpaint.color.street.facade"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.facade}"
          }
        }
      },
      "shutter": {
        "$value": "{color.palette.shutter}",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "ts": "soiSignpaint.color.street.shutter"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.shutter}"
          }
        }
      },
      "ink": {
        "$value": "{color.palette.ink}",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "ts": "soiSignpaint.color.street.ink"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.line}"
          }
        }
      },
      "plateCream": {
        "$value": "{color.palette.plate}",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "ts": "soiSignpaint.color.street.plateCream"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.neon-mustard}"
          }
        }
      },
      "plateBlue": {
        "$value": "{color.palette.blue}",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
              "capacitor"
            ],
            "ts": "soiSignpaint.color.street.plateBlue"
          },
          "us.kensaur.glot": {
            "dark": "{color.night.neon-blue}"
          }
        }
      },
      "plateRed": {
        "$value": "{color.palette.signal}",
        "$extensions": {
          "us.kensaur.mushi": {
            "platforms": [
              "web",
