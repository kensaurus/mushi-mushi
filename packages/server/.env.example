# Edge function secrets. Set them with `npx supabase secrets set NAME=value`
# (this file is a template, not loaded in production). The self-hosting docs'
# Environment variables page is generated from it: `pnpm gen:env-reference`.

# --- Core (selfhost up sets these) ---
# MUSHI_INTERNAL_CALLER_SECRET=…   # Lets pg_cron call your functions; the same value goes in mushi_runtime_config
# ADMIN_BASE_URL=https://mushi.example.com  # Where your console is served; links in Slack, Discord and email open it

# --- AI keys (optional; one turns on the plain-English diagnosis and fix drafts) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-…              # Either provider works; OpenAI also powers duplicate detection, semantic search and voice
# Agent PR review model for every project that has not set its own
# (project_settings.agent_pr_review_model, ADR 0039). Default: claude-opus-5-5.
# AGENT_PR_REVIEW_MODEL=claude-opus-5-5

# --- Operator notices and Slack routing (optional) ---
# MUSHI_FUNCTION_REGION=ap-northeast-1  # Your database's region: pins the Slack bot's Request URLs there (?forceFunctionRegion), so Slack's US calls answer inside its 3 s limit
# MUSHI_OPS_KEY=mushi_…            # Optional: this deployment's own ops:write key; operator notices (payments, alerts) go to the Ops hub's Slack bot, the webhooks are the fallback
# MUSHI_OPS_API_URL=https://<ref>.supabase.co/functions/v1/api  # Optional: where those notices go (default: this project's own api)

# --- Discord triage feed (optional) ---
# Centralised Discord triage (_shared/discord-triage.README.md).
# Cross-project operator feed — distinct from the per-project
# project_settings.discord_webhook_url. Unset = silent no-op.
# Webhook mode:
# MUSHI_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/…
# MUSHI_DISCORD_THREAD_ID=…        # Optional; posts into an existing thread
# Relay mode (channels where the bot lacks MANAGE_WEBHOOKS):
# MUSHI_TRIAGE_RELAY_URL=https://…/functions/v1/tsumagoi-kensaurus-sales-relay
# MUSHI_TRIAGE_RELAY_TOKEN=…       # Sent as the x-relay-token header
# MUSHI_TRIAGE_RELAY_THREAD=support  # Default. Absent/other => relay posts to sales
# MUSHI_DISCORD_MIN_LEVEL=error    # low|medium|high|critical (error→high). Default: error

# --- Code index (optional) ---
# Codebase index sweep (webhooks-github-indexer). The coverage ceiling (files
# a project's index may hold) follows the plan: Free 300, Builder (indie) 1,500,
# Studio (pro) 5,000, Enterprise 20,000, or pricing_plans.feature_flags
# .codebase_index_file_cap. Setting the cap pins it for EVERY project, so leave
# it unset on Mushi Cloud; self-hosts (no billing plans) set it here.
# MUSHI_REPO_INDEX_SWEEP_FILE_CAP=300
# Files one sweep fetches (bounded by the edge function's wall clock and the
# GitHub token's rate limit); a larger ceiling fills over hourly runs.
# MUSHI_REPO_INDEX_SWEEP_RUN_FILES=300

# --- Public diagram pages (optional) ---
# Public architecture-diagram pages (docs/operators/public-diagram-pages.md).
# An IAM user limited to s3:PutObject + s3:DeleteObject on
# arn:aws:s3:::<bucket>/mushi-mushi/r/*. Unset = the crawlable page and its
# .md twin are not written; the diagram still shows via the docs 404 fallback.
# MUSHI_PUBLIC_PAGES_BUCKET=kensaur.us-mushi-mushi
# MUSHI_PUBLIC_PAGES_REGION=us-east-1
# MUSHI_PUBLIC_PAGES_ACCESS_KEY_ID=AKIA...
# MUSHI_PUBLIC_PAGES_SECRET_ACCESS_KEY=...

# --- Self-hosted Sentry hosts (optional) ---
# Self-hosted Sentry (_shared/sentry-dsn.ts). A Sentry DSN on a published app
# or in Settings → General must point at sentry.io (or a subdomain such as
# o123.ingest.us.sentry.io). List extra hosts here, comma separated, to accept
# a self-hosted Sentry. IP addresses, localhost and internal names are refused
# even when listed. Unset = sentry.io only.
# MUSHI_SENTRY_SELF_HOSTED_HOSTS=sentry.example.com

# --- Origins (optional; redirects and links in email) ---
# ADMIN_ORIGIN=https://kensaur.us/mushi-mushi/admin
# MUSHI_ADMIN_URL=https://kensaur.us/mushi-mushi/admin
# MUSHI_ADMIN_BASE_URL=https://kensaur.us/mushi-mushi/admin
# SITE_URL=https://kensaur.us/mushi-mushi/admin
# APP_URL=https://kensaur.us/mushi-mushi/admin
# MUSHI_API_PUBLIC_URL=https://your-project-ref.supabase.co/functions/v1/api
# First origin is the CLI device-auth approval page.
# MUSHI_ADMIN_ORIGIN_ALLOWLIST=https://kensaur.us
# DEFAULT_BASE_URL=https://your-app.example.com
# MCP_PUBLIC_BASE_URL=https://kensaur.us/mushi-mushi/hosted-mcp
# TELEGRAM_WEBHOOK_BASE_URL=https://your-project-ref.supabase.co/functions/v1

# --- Runtime name (optional; unset is treated as production) ---
# SUPABASE_ENV=production
# DENO_ENV=production
# MUSHI_CLUSTER_REGION=us
# MUSHI_VERSION=

# --- GitHub App (optional) ---
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PEM=
# GITHUB_APP_WEBHOOK_SECRET=
# "Connect GitHub" in the console (verified install + repository picker):
# the App's slug, OAuth client id and secret. The App's callback URLs must
# include <SUPABASE_URL>/functions/v1/api/v1/webhooks/github/app-authorize
# (or GITHUB_APP_OAUTH_REDIRECT_URL when set). MUSHI_GITHUB_CONNECT_SECRET
# signs the short-lived link and grant; unset uses the service role key.
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_OAUTH_REDIRECT_URL=
# MUSHI_GITHUB_CONNECT_SECRET=
# The platform GITHUB_TOKEN serves only apps whose owner is listed here.
# GITHUB_TOKEN=
# MUSHI_OPERATOR_USER_IDS=
# Single-tenant self-host only. Hosted production leaves this unset.
# MUSHI_GITHUB_APP_TRUST_UNVERIFIED_INSTALLS=0

# --- Slack OAuth (optional; operator workspace) ---
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# SLACK_STATE_SECRET=
# SLACK_REDIRECT_URI=

# --- Linear OAuth (optional) ---
# LINEAR_OAUTH_CLIENT_ID=
# LINEAR_OAUTH_CLIENT_SECRET=

# --- Email (optional; both required before any mail is sent) ---
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Mushi Mushi <mushi@example.com>
# LIFECYCLE_UNSUB_SECRET=

# --- Tremendous tester payouts (optional; set the host explicitly) ---
# TREMENDOUS_API_KEY=
# TREMENDOUS_API_URL=https://testflight.tremendous.com/api/v2
# TREMENDOUS_WEBHOOK_SECRET=
# TESTER_TIN_PEPPER=

# --- AWS Bedrock fine-tune (optional; off until the flag is 1) ---
# MUSHI_BEDROCK_FINETUNE_ENABLED=0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1
# BEDROCK_REGION=us-east-1
# BEDROCK_ROLE_ARN=
# BEDROCK_OUTPUT_S3_URI=s3://your-bucket/mushi-ft/
# MUSHI_ALLOW_STUB_FINE_TUNE=0

# --- Hosted LLM billing (optional; stays off without the wallet bridge) ---
# MUSHI_HOSTED_LLM_BILLING=off
# KENSAURUS_WALLET_URL=
# KENSAURUS_WALLET_INTERNAL_TOKEN=
# MUSHI_HOSTED_LLM_PREFLIGHT_TIMEOUT_MS=800

# --- Hosted LLM provider order (optional) ---
# Which vendor the platform keys try first, comma-separated from openai,
# openrouter, anthropic. A vendor left out is never used on the platform key.
# An app's own keys (BYOK) are not affected. Flip it for a contingency.
# Default: openai,openrouter,anthropic
# MUSHI_HOSTED_LLM_ORDER=openai,openrouter,anthropic
# Drill: anthropic_no_credit makes every platform-key Claude call fail with
# Anthropic's low-credit error, without sending it. Leave unset.
# MUSHI_LLM_DRILL=

# --- OpenAI-compatible endpoint (optional) ---
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_WEBHOOK_SECRET=
# MUSHI_OPENAI_BASE_URL_ALLOWLIST=
# Self-host: true lets OPENAI_BASE_URL (this server-wide setting only, never a
# per-key base URL) be your own http model server, e.g. http://ollama:11434/v1.
# MUSHI_ALLOW_PRIVATE_LLM_BASE_URL=false
# The model that server serves, for every chat call (any name, e.g. qwen3.8:27b).
# MUSHI_OPENAI_MODEL=
# Its embedding model; must return 1536-dimension vectors. Unset = OpenAI's id.
# MUSHI_OPENAI_EMBEDDING_MODEL=
# Per-tier renames, which win over MUSHI_OPENAI_MODEL: gpt-6-luna=small,gpt-6.1-terra=large
# MUSHI_OPENAI_MODEL_MAP=

# --- Self-host public address (optional; unset on the hosted platform) ---
# The address people use. Signed Storage links are rewritten to it when SUPABASE_URL is an internal gateway.
# SUPABASE_PUBLIC_URL=https://mushi.example.com

# --- QA crawl providers (optional; project BYOK wins when set) ---
# FIRECRAWL_API_KEY=
# BROWSERBASE_API_KEY=

# --- Operators, bootstrap, and safety switches (optional) ---
# MUSHI_OPERATOR_USER_IDS=
# Providers & AI routes (/providers, operators only): the kensaurus-ops API and its console token.
# Both unset: the route answers 404. See docs/operators/providers-ai-routes.md.
# KENSAURUS_OPS_URL=
# KENSAURUS_OPS_CONSOLE_TOKEN=
# Fresh-eyes test accounts (ADR 0053): the email domain; one no mailbox answers on. Default synthetic.kensaur.us.
# MUSHI_FRESH_EYES_EMAIL_DOMAIN=
# MUSHI_INIT_OWNER_EMAIL=
# MUSHI_INIT_ORG_NAME=
# MUSHI_INIT_ORG_ID=
# MUSHI_INIT_PROJECT_NAME=
# MUSHI_INIT_PROJECT_ID=
# MUSHI_INIT_REPORTER_KEY=
# MUSHI_EE_LICENSE_KEY=
# MUSHI_EE_PUBLIC_KEY=
# MUSHI_SELF_PROJECT_ID=
# MUSHI_ALLOW_INTERNAL_PUSH=0
# MUSHI_ALLOW_LOCAL_SANDBOX=0
# MUSHI_ALLOW_PRIVATE_STORAGE_ENDPOINT=0
# MUSHI_SCREENSHOT_HOST_ALLOWLIST=
# JIRA_DONE_TRANSITION_ID=31
# CURSOR_USE_V0_WEBHOOK=0
# MUSHI_CI_SYNC_BATCH=20
# MUSHI_FIX_MIN_RAG_CHUNKS=1
# MUSHI_FREE_REPORTS_PER_MONTH=1000
# MUSHI_INVENTORY_DRIFT_ROUTES=5
# MUSHI_INVENTORY_DRIFT_COOLDOWN_DAYS=7
# MUSHI_INVENTORY_DRIFT_MAX_PER_RUN=1

# --- Instance and support (optional) ---
# hosted | self-hosted. Unset: self-hosted unless SUPABASE_URL is Mushi Mushi Cloud's
# project. GET /health reports it; `mushi selfhost up` and Compose set self-hosted.
# MUSHI_INSTANCE_MODE=self-hosted
# Console address in key-created and usage-alert emails. Default: https://kensaur.us/mushi-mushi/admin
# MUSHI_CONSOLE_URL=https://mushi.example.com
# API address the console shows for SDK setup. Default: <SUPABASE_URL>/functions/v1/api
# MUSHI_API_ENDPOINT=https://your-project-ref.supabase.co/functions/v1/api
# SUPPORT_EMAIL=support@example.com
# SUPPORT_URL=https://example.com/support
# Operator alerts (payments, platform notices) when no Ops hub key is set.
# OPERATOR_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/…
# OPERATOR_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/…

# --- Observability (optional) ---
# Langfuse LLM traces. LANGFUSE_HOST is an alias of LANGFUSE_BASE_URL.
# LANGFUSE_PUBLIC_KEY=pk-lf-…
# LANGFUSE_SECRET_KEY=sk-lf-…
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_HOST=
# Server errors to Sentry. SENTRY_DSN_SERVER wins; SENTRY_DSN also works.
# SENTRY_DSN_SERVER=https://…@sentry.io/…
# SENTRY_DSN=
# SENTRY_RELEASE=
# Default: 0.05
# SENTRY_TRACES_SAMPLE_RATE=0.05
# OpenTelemetry span per classification (classify-report).
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-collector/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=

# --- Integration probes (optional; operator-wide tokens) ---
# Used by the Integrations health probes when an app has no key of its own.
# CURSOR_API_KEY=
# LINEAR_API_KEY=

# --- Mushi Mushi Cloud billing (hosted only; a self-host leaves these unset) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_LIVEMODE=false
# STRIPE_SUCCESS_URL=
# STRIPE_CANCEL_URL=
# STRIPE_PORTAL_RETURN_URL=
# STRIPE_DEFAULT_PRICE_ID=
# STRIPE_METER_EVENT_NAME=
# STRIPE_METER_REPORTS_EVENT_NAME=
# STRIPE_METER_DIAGNOSES_EVENT_NAME=
# STRIPE_METER_FIXES_EVENT_NAME=
# STRIPE_PRICE_STARTER_BASE=
# STRIPE_PRICE_STARTER_OVERAGE=
# STRIPE_PRICE_INDIE_BASE=
# STRIPE_PRICE_INDIE_ANNUAL=
# STRIPE_PRICE_INDIE_DIAGNOSES_OVERAGE=
# STRIPE_PRICE_PRO_BASE=
# STRIPE_PRICE_PRO_BASE_V2=
# STRIPE_PRICE_PRO_ANNUAL=
# STRIPE_PRICE_PRO_OVERAGE=
# STRIPE_PRICE_PRO_DIAGNOSES_OVERAGE=
