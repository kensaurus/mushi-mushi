# Required for LLM classification (classify-report edge function)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Edge secrets (set via `npx supabase secrets set` — not loaded from this file in production):
# ADMIN_BASE_URL=https://your-domain.example.com/admin
# MUSHI_INTERNAL_CALLER_SECRET=…   # Required for pg_cron → edge internal calls
# OPENAI_API_KEY=sk-…              # Optional LLM failover

# Centralised Discord triage (_shared/discord-triage.README.md).
# Cross-project operator feed — distinct from the per-project
# project_settings.discord_webhook_url. Unset = silent no-op.
# Webhook mode:
# MUSHI_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/…
# MUSHI_DISCORD_THREAD_ID=…        # Optional; posts into an existing thread
# Relay mode (channels where the bot lacks MANAGE_WEBHOOKS):
# MUSHI_TRIAGE_RELAY_URL=https://…/functions/v1/tsumagoi-kensaurus-sales-relay
# MUSHI_TRIAGE_RELAY_TOKEN=…       # Sent as the x-relay-token header
# MUSHI_TRIAGE_RELAY_THREAD=support  # Default. Absent/other => relay posts to sales
# MUSHI_DISCORD_MIN_LEVEL=error    # low|medium|high|critical (error→high). Default: error

# Codebase index sweep (webhooks-github-indexer). The coverage ceiling (files
# a project's index may hold) follows the plan: free 300, starter/indie 1,500,
# pro 5,000, enterprise 20,000, or pricing_plans.feature_flags
# .codebase_index_file_cap. Setting the cap pins it for EVERY project, so leave
# it unset on Mushi Cloud; self-hosts (no billing plans) set it here.
# MUSHI_REPO_INDEX_SWEEP_FILE_CAP=300
# Files one sweep fetches (bounded by the edge function's wall clock and the
# GitHub token's rate limit); a larger ceiling fills over hourly runs.
# MUSHI_REPO_INDEX_SWEEP_RUN_FILES=300

# Public architecture-diagram pages (docs/operators/public-diagram-pages.md).
# An IAM user limited to s3:PutObject + s3:DeleteObject on
# arn:aws:s3:::<bucket>/mushi-mushi/r/*. Unset = the crawlable page and its
# .md twin are not written; the diagram still shows via the docs 404 fallback.
# MUSHI_PUBLIC_PAGES_BUCKET=kensaur.us-mushi-mushi
# MUSHI_PUBLIC_PAGES_REGION=us-east-1
# MUSHI_PUBLIC_PAGES_ACCESS_KEY_ID=AKIA...
# MUSHI_PUBLIC_PAGES_SECRET_ACCESS_KEY=...

# Self-hosted Sentry (_shared/sentry-dsn.ts). A Sentry DSN on a published app
# or in Settings → General must point at sentry.io (or a subdomain such as
# o123.ingest.us.sentry.io). List extra hosts here, comma separated, to accept
# a self-hosted Sentry. IP addresses, localhost and internal names are refused
# even when listed. Unset = sentry.io only.
# MUSHI_SENTRY_SELF_HOSTED_HOSTS=sentry.example.com
