# Required for LLM classification (classify-report edge function)
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Agent PR review model for every project that has not set its own
# (project_settings.agent_pr_review_model, ADR 0039). Default: claude-opus-5-5.
# AGENT_PR_REVIEW_MODEL=claude-opus-5-5

# Edge secrets (set via `npx supabase secrets set` — not loaded from this file in production):
# ADMIN_BASE_URL=https://your-domain.example.com/admin
# MUSHI_INTERNAL_CALLER_SECRET=…   # Required for pg_cron → edge internal calls
# OPENAI_API_KEY=sk-…              # Optional LLM failover

# Centralised Discord triage (_shared/discord-triage.README.md).
# Cross-project operator feed — distinct from the per-project
# project_settings.discord_webhook_url. Unset = silent no-op.
# Webhook mode:
# MUSHI_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/…
# MUSHI_DISCORD_THREAD_ID=…        # Optional; posts into an existing thread
# Relay mode (channels where the bot lacks MANAGE_WEBHOOKS):
# MUSHI_TRIAGE_RELAY_URL=https://…/functions/v1/tsumagoi-kensaurus-sales-relay
# MUSHI_TRIAGE_RELAY_TOKEN=…       # Sent as the x-relay-token header
# MUSHI_TRIAGE_RELAY_THREAD=support  # Default. Absent/other => relay posts to sales
# MUSHI_DISCORD_MIN_LEVEL=error    # low|medium|high|critical (error→high). Default: error

# Codebase index sweep (webhooks-github-indexer). The coverage ceiling (files
# a project's index may hold) follows the plan: free 300, starter/indie 1,500,
# pro 5,000, enterprise 20,000, or pricing_plans.feature_flags
# .codebase_index_file_cap. Setting the cap pins it for EVERY project, so leave
# it unset on Mushi Cloud; self-hosts (no billing plans) set it here.
# MUSHI_REPO_INDEX_SWEEP_FILE_CAP=300
# Files one sweep fetches (bounded by the edge function's wall clock and the
# GitHub token's rate limit); a larger ceiling fills over hourly runs.
# MUSHI_REPO_INDEX_SWEEP_RUN_FILES=300

# Public architecture-diagram pages (docs/operators/public-diagram-pages.md).
# An IAM user limited to s3:PutObject + s3:DeleteObject on
# arn:aws:s3:::<bucket>/mushi-mushi/r/*. Unset = the crawlable page and its
# .md twin are not written; the diagram still shows via the docs 404 fallback.
# MUSHI_PUBLIC_PAGES_BUCKET=kensaur.us-mushi-mushi
# MUSHI_PUBLIC_PAGES_REGION=us-east-1
# MUSHI_PUBLIC_PAGES_ACCESS_KEY_ID=AKIA...
# MUSHI_PUBLIC_PAGES_SECRET_ACCESS_KEY=...

# Self-hosted Sentry (_shared/sentry-dsn.ts). A Sentry DSN on a published app
# or in Settings → General must point at sentry.io (or a subdomain such as
# o123.ingest.us.sentry.io). List extra hosts here, comma separated, to accept
# a self-hosted Sentry. IP addresses, localhost and internal names are refused
# even when listed. Unset = sentry.io only.
# MUSHI_SENTRY_SELF_HOSTED_HOSTS=sentry.example.com

# --- Origins (optional; redirects and links in email) ---
# ADMIN_ORIGIN=https://kensaur.us/mushi-mushi/admin
# MUSHI_ADMIN_URL=https://kensaur.us/mushi-mushi/admin
# MUSHI_ADMIN_BASE_URL=https://kensaur.us/mushi-mushi/admin
# SITE_URL=https://kensaur.us/mushi-mushi/admin
# APP_URL=https://kensaur.us/mushi-mushi/admin
# MUSHI_API_PUBLIC_URL=https://your-project-ref.supabase.co/functions/v1/api
# First origin is the CLI device-auth approval page.
# MUSHI_ADMIN_ORIGIN_ALLOWLIST=https://kensaur.us
# DEFAULT_BASE_URL=https://your-app.example.com
# MCP_PUBLIC_BASE_URL=https://kensaur.us/mushi-mushi/hosted-mcp
# TELEGRAM_WEBHOOK_BASE_URL=https://your-project-ref.supabase.co/functions/v1

# --- Runtime name (optional; unset is treated as production) ---
# SUPABASE_ENV=production
# DENO_ENV=production
# MUSHI_CLUSTER_REGION=us
# MUSHI_VERSION=

# --- GitHub App (optional) ---
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PEM=
# GITHUB_APP_WEBHOOK_SECRET=
# Single-tenant self-host only. Hosted production leaves this unset.
# MUSHI_GITHUB_APP_TRUST_UNVERIFIED_INSTALLS=0

# --- Slack OAuth (optional; operator workspace) ---
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# SLACK_STATE_SECRET=
# SLACK_REDIRECT_URI=

# --- Linear OAuth (optional) ---
# LINEAR_OAUTH_CLIENT_ID=
# LINEAR_OAUTH_CLIENT_SECRET=

# --- Email (optional; both required before any mail is sent) ---
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Mushi Mushi <mushi@example.com>
# LIFECYCLE_UNSUB_SECRET=

# --- Tremendous tester payouts (optional; set the host explicitly) ---
# TREMENDOUS_API_KEY=
# TREMENDOUS_API_URL=https://testflight.tremendous.com/api/v2
# TREMENDOUS_WEBHOOK_SECRET=
# TESTER_TIN_PEPPER=

# --- AWS Bedrock fine-tune (optional; off until the flag is 1) ---
# MUSHI_BEDROCK_FINETUNE_ENABLED=0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1
# BEDROCK_REGION=us-east-1
# BEDROCK_ROLE_ARN=
# BEDROCK_OUTPUT_S3_URI=s3://your-bucket/mushi-ft/
# MUSHI_ALLOW_STUB_FINE_TUNE=0

# --- Hosted LLM billing (optional; stays off without the wallet bridge) ---
# MUSHI_HOSTED_LLM_BILLING=off
# KENSAURUS_WALLET_URL=
# KENSAURUS_WALLET_INTERNAL_TOKEN=
# MUSHI_HOSTED_LLM_PREFLIGHT_TIMEOUT_MS=800

# --- OpenAI-compatible endpoint (optional) ---
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_WEBHOOK_SECRET=
# MUSHI_OPENAI_BASE_URL_ALLOWLIST=

# --- QA crawl providers (optional; project BYOK wins when set) ---
# FIRECRAWL_API_KEY=
# BROWSERBASE_API_KEY=

# --- Operators, bootstrap, and safety switches (optional) ---
# MUSHI_OPERATOR_USER_IDS=
# Fresh-eyes test accounts (ADR 0053): the email domain; one no mailbox answers on. Default synthetic.kensaur.us.
# MUSHI_FRESH_EYES_EMAIL_DOMAIN=
# MUSHI_INIT_ORG_NAME=
# MUSHI_INIT_ORG_ID=
# MUSHI_INIT_PROJECT_NAME=
# MUSHI_INIT_PROJECT_ID=
# MUSHI_INIT_REPORTER_KEY=
# MUSHI_EE_LICENSE_KEY=
# MUSHI_EE_PUBLIC_KEY=
# MUSHI_SELF_PROJECT_ID=
# MUSHI_ALLOW_INTERNAL_PUSH=0
# MUSHI_ALLOW_LOCAL_SANDBOX=0
# MUSHI_ALLOW_PRIVATE_STORAGE_ENDPOINT=0
# MUSHI_SCREENSHOT_HOST_ALLOWLIST=
# JIRA_DONE_TRANSITION_ID=31
# CURSOR_USE_V0_WEBHOOK=0
# MUSHI_CI_SYNC_BATCH=20
# MUSHI_FIX_MIN_RAG_CHUNKS=1
# MUSHI_FREE_REPORTS_PER_MONTH=1000
# MUSHI_INVENTORY_DRIFT_ROUTES=5
# MUSHI_INVENTORY_DRIFT_COOLDOWN_DAYS=7
# MUSHI_INVENTORY_DRIFT_MAX_PER_RUN=1
