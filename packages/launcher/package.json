{
  "name": "mushi-mushi",
  "version": "0.8.1",
  "license": "MIT",
  "description": "One command adds a bug report widget to any app. The bug mediator for AI-built apps: plain-English diagnosis + a ready fix, in your editor.",
  "bin": {
    "mushi-mushi": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mushi-mushi/cli": "workspace:^"
  },
  "devDependencies": {
    "@mushi-mushi/eslint-config": "workspace:*",
    "@types/node": "^22.20.0",
    "eslint": "^10.6.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "author": "Kenji Sakuramoto <kensaurus@gmail.com> (https://github.com/kensaurus)",
  "repository": {
    "type": "git",
    "url": "https://github.com/kensaurus/mushi-mushi.git",
    "directory": "packages/launcher"
  },
  "homepage": "https://kensaur.us/mushi-mushi",
  "bugs": {
    "url": "https://github.com/kensaurus/mushi-mushi/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "mushi-mushi",
    "bug-report-widget",
    "bug-reporting",
    "user-feedback",
    "user-report",
    "feedback-widget",
    "session-replay",
    "screenshot",
    "shake-to-report",
    "sdk",
    "wizard",
    "setup",
    "init",
    "react",
    "next.js",
    "nextjs",
    "vue",
    "nuxt",
    "svelte",
    "sveltekit",
    "angular",
    "react-native",
    "expo",
    "capacitor",
    "ionic",
    "sentry-companion",
    "error-tracking",
    "ai-triage",
    "ai-agent",
    "auto-fix",
    "llm",
    "llm-ops",
    "mushi"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  }
}
