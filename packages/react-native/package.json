{
  "name": "@mushi-mushi/react-native",
  "version": "0.26.1",
  "license": "MIT",
  "description": "Bug report widget for React Native and Expo. One place to improve AI-built apps: fix bugs, smooth user journeys and clean up the code.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "lint": "eslint src/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "size": "size-limit"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.19",
    "@react-native-community/netinfo": ">=11",
    "@react-navigation/native": ">=6",
    "expo-sensors": ">=13",
    "expo-secure-store": ">=13",
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-view-shot": ">=3.8"
  },
  "peerDependenciesMeta": {
    "@react-navigation/native": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "expo-sensors": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "@react-native-community/netinfo": {
      "optional": true
    },
    "react-native-view-shot": {
      "optional": true
    }
  },
  "dependencies": {
    "@mushi-mushi/core": "workspace:^",
    "@mushi-mushi/web": "workspace:^"
  },
  "devDependencies": {
    "@mushi-mushi/eslint-config": "workspace:*",
    "@size-limit/file": "^14.3.0",
    "@types/react": "^19.3.0",
    "eslint": "^10.6.0",
    "eslint-plugin-mushi-mushi": "workspace:*",
    "react": "^19.3.0",
    "react-native": "^0.88.1",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "author": "Kenji Sakuramoto <kensaurus@gmail.com> (https://github.com/kensaurus)",
  "repository": {
    "type": "git",
    "url": "https://github.com/kensaurus/mushi-mushi.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://kensaur.us/mushi-mushi",
  "bugs": {
    "url": "https://github.com/kensaurus/mushi-mushi/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "mushi-mushi",
    "bug-report-widget",
    "bug-reporting",
    "user-feedback",
    "user-report",
    "feedback-widget",
    "react-native",
    "expo",
    "shake-to-report",
    "bottom-sheet",
    "screenshot",
    "session-replay",
    "offline-queue",
    "sentry-companion",
    "error-tracking",
    "ai-triage",
    "auto-fix",
    "llm-ops",
    "ai-agent",
    "sdk"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  }
}
