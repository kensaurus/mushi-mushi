{
  "name": "eslint-plugin-mushi-mushi",
  "version": "0.3.6",
  "description": "ESLint rules that catch what AI coding tools often ship: buttons wired to empty handlers, and faker or placeholder data left in production code.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./recommended": {
      "import": {
        "types": "./dist/recommended.d.ts",
        "default": "./dist/recommended.js"
      },
      "require": {
        "types": "./dist/recommended.d.cts",
        "default": "./dist/recommended.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kensaurus/mushi-mushi.git",
    "directory": "packages/eslint-plugin-mushi-mushi"
  },
  "homepage": "https://kensaur.us/mushi-mushi",
  "bugs": {
    "url": "https://github.com/kensaurus/mushi-mushi/issues"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "mushi-mushi",
    "agentic-coding",
    "vibe-coding",
    "dead-code",
    "mocks",
    "lint-rules",
    "static-analysis",
    "code-quality"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "eslint": ">=8.0.0"
  },
  "devDependencies": {
    "@mushi-mushi/eslint-config": "workspace:*",
    "@mushi-mushi/tsconfig": "workspace:*",
    "@types/estree": "^1.0.9",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.6.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "author": "Kenji Sakuramoto <kensaurus@gmail.com> (https://github.com/kensaurus)",
  "engines": {
    "node": ">=20.19.0"
  }
}
