{
  "extends": "../../tooling/tsconfig/node.json",
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": "dist",
    "rootDir": "src",
    "noUncheckedIndexedAccess": true,
    "types": [
      "node",
      "vscode"
    ],
    "verbatimModuleSyntax": false
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
