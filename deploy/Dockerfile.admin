# FILE: Dockerfile.admin
# PURPOSE: Build and serve the admin console
#
# The backend is set when the container starts, not when it is built:
# admin/40-mushi-env.sh writes env.js from VITE_SUPABASE_URL,
# VITE_SUPABASE_ANON_KEY, VITE_API_URL and MUSHI_LOCAL_ONLY. Built with no
# VITE_* values, so no Mushi Cloud project, Sentry DSN or dogfooding SDK key
# is baked in.

# Base images pinned by digest (OpenSSF Scorecard Pinned-Dependencies). Refresh
# with `docker buildx imagetools inspect <image>` on upgrade.
FROM node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS builder
WORKDIR /app
# The admin console imports several workspace packages (brand, core, web,
# mcp, marketing-ui, …); build them in dependency order as deploy-admin.yml
# does, then the console itself.
COPY . .
RUN corepack enable && pnpm install --frozen-lockfile
RUN pnpm --filter @mushi-mushi/admin... --filter '!@mushi-mushi/admin' build
RUN pnpm --filter @mushi-mushi/admin build

FROM nginx:alpine@sha256:54f2a904c251d5a34adf545a72d32515a15e08418dae0266e23be2e18c66fefa
COPY --from=builder /app/apps/admin/dist /usr/share/nginx/html
COPY deploy/admin/nginx.conf /etc/nginx/conf.d/default.conf
# The nginx image runs executable scripts in /docker-entrypoint.d/ before
# nginx starts (only when the command is nginx, as below).
COPY --chmod=0755 deploy/admin/40-mushi-env.sh /docker-entrypoint.d/40-mushi-env.sh
EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
