# deploy/.env.example — variables deploy/docker-compose.yml reads.
#
# Do not copy this file and fill it by hand. Generate deploy/.env instead:
#   ./deploy/generate-secrets.sh          (bash + openssl)
#   npx mushi-mushi selfhost secrets      (any OS with Node 22+)
# Both write random values and sign the two JWTs with JWT_SECRET, so the
# keys always match. Compose refuses to start while a required value is empty.

# Public address of the stack. Caddy serves the console at / and the API under
# /functions/v1, /auth/v1, /rest/v1 and /storage/v1 on the same origin.
# A domain name (https://mushi.example.com) gets a certificate automatically.
MUSHI_PUBLIC_URL=http://localhost
MUSHI_SITE_ADDRESS=http://localhost

# Required (generated)
POSTGRES_PASSWORD=
JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MUSHI_INTERNAL_CALLER_SECRET=

# Optional: one LLM key turns on the plain-English diagnosis and fix drafts.
# Either provider works. Without one, reports get rule-based triage only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: Langfuse tracing
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# Optional: headless bootstrap of the first team, app and reporter key
# (POST /v1/admin/bootstrap). The owner signs up in the console first.
# MUSHI_INIT_OWNER_EMAIL=
# MUSHI_INIT_ORG_NAME=
# MUSHI_INIT_PROJECT_NAME=
# MUSHI_INIT_REPORTER_KEY=
