
############
# Mushi Mushi
############
# install.sh appends this block to Supabase's .env and fills in the values
# marked @...@. Every name here is read by docker-compose.mushi.yml.

# Image tag: latest, or a pinned sha-<commit> (sh mushi.sh update <tag>).
# Install-time only, for images you built yourself: MUSHI_SKIP_PULL=1 sh install.sh
# MUSHI_SKIP_PULL=0
MUSHI_VERSION=@MUSHI_VERSION@
# The one URL people, the SDK, the CLI and MCP use. Behind a reverse proxy: your https URL.
MUSHI_PUBLIC_URL=@MUSHI_PUBLIC_URL@
# 127.0.0.1 keeps the console private to this machine (use a reverse proxy,
# `sh mushi.sh https <domain>` or an SSH tunnel). 0.0.0.0 publishes it everywhere.
MUSHI_BIND=127.0.0.1
MUSHI_PORT=3000
# Shared by the database's scheduled jobs and the functions (generated).
MUSHI_INTERNAL_CALLER_SECRET=@MUSHI_INTERNAL_CALLER_SECRET@
# off: no monthly caps (you pay your own model provider). on: hosted plan caps.
MUSHI_PLAN_LIMITS=off
MUSHI_CLUSTER_REGION=us

# AI for plain-English diagnoses (optional; reports are taken without it).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY is in Supabase's section above (Studio's assistant reads it too).
# Your own OpenAI-compatible server (Ollama, vLLM, LM Studio, llama.cpp):
#   sh mushi.sh llm http://host.docker.internal:11434/v1 <model your server serves>
# sets the four lines below. Any model works; change it the same way later.
OPENAI_BASE_URL=
MUSHI_ALLOW_PRIVATE_LLM_BASE_URL=false
MUSHI_OPENAI_MODEL=
# Optional: an embedding model returning 1536-dimension vectors (similar-bug search).
MUSHI_OPENAI_EMBEDDING_MODEL=
# Optional: a different model per Mushi tier, e.g. gpt-6-luna=small-model,gpt-6.1-terra=big-model
MUSHI_OPENAI_MODEL_MAP=
OPENROUTER_API_KEY=

# Optional integrations
FIRECRAWL_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GITHUB_TOKEN=
SENTRY_DSN_SERVER=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
